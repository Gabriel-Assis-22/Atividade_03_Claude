        "/api/profile/me": {
            "get": {
                "tags": [
                    "Profile"
                ],
                "summary": "Obt\u00e9m os dados completos do perfil do usu\u00e1rio logado (incluindo favoritos e foto).",
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/profile": {
            "put": {
                "tags": [
                    "Profile"
                ],
                "summary": "Atualiza as informa\u00e7\u00f5es do perfil (ex: bio).\r\nProtegido estritamente contra IDOR (Requisito 4): se um TargetUserId alheio for fornecido, retorna 403 Forbidden.",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        },
                        "text/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        },
                        "application/*+json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/profile/photo": {
            "post": {
                "tags": [
                    "Profile"
                ],
                "summary": "Realiza o upload da foto de perfil para o MinIO (Requisito 2).\r\nValida tipo de arquivo, tamanho m\u00e1ximo e armazena a refer\u00eancia no MariaDB.",
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            },
                            "encoding": {
                                "file": {
                                    "style": "form"
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        },
        "/api/profile/photo/{key}": {
            "get": {
                "tags": [
                    "Profile"
                ],
                "summary": "Retorna a foto de perfil armazenada no Garage S3 de forma segura e com cache.\r\nAcesso p\u00fablico para exibi\u00e7\u00e3o nos avatares.",
                "parameters": [
                    {
                        "name": "key",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AddCommentRequest": {
                "type": "object",
                "properties": {
                    "tmdbMovieId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "texto": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "AddFavoriteRequest": {
                "type": "object",
                "properties": {
                    "tmdbMovieId": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "titulo": {
                        "type": "string",
                        "nullable": true
                    },
                    "posterPath": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "ForgotPasswordRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "LoginRequest": {
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "senha": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "RegisterRequest": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "nullable": true
                    },
                    "email": {
                        "type": "string",
                        "nullable": true
                    },
                    "senha": {
                        "type": "string",
                        "nullable": true
                    },
                    "role": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "ResetPasswordRequest": {
                "type": "object",
                "properties": {
                    "token": {
                        "type": "string",
                        "nullable": true
                    },
                    "novaSenha": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            },
            "UpdateProfileRequest": {
                "type": "object",
                "properties": {
                    "targetUserId": {
                        "type": "integer",
                        "format": "int32",
                        "nullable": true
                    },
                    "bio": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "additionalProperties": false
            }
        },
        "securitySchemes": {
            "Bearer": {
                "type": "apiKey",
                "description": "Autentica\u00e7\u00e3o JWT Bearer. Digite 'Bearer {seu_token}' no campo abaixo para autorizar requisi\u00e7\u00f5es.",
                "name": "Authorization",
                "in": "header"
            }
        }
    },
    "security": [
        {
            "Bearer": []
        }
    ]
}
