{
    "openapi": "3.0.1",
    "info": {
        "title": "Cat\u00e1logo Tom Hanks API",
        "description": "API REST de Microsservi\u00e7os para o Cat\u00e1logo Tom Hanks. Inclui Cat\u00e1logo TMDB, Favoritos (com limita\u00e7\u00e3o de 3 no plano gratuito e ilimitado no Premium), Coment\u00e1rios, Perfil de Usu\u00e1rio, Upload de Avatar no Garage S3, Pagamentos Stripe e Trilha de Auditoria.",
        "contact": {
            "name": "Gabriel Assis",
            "url": "https://github.com/Gabriel-Assis-22/Atividade_02_Claude"
        },
        "version": "v1"
    },
