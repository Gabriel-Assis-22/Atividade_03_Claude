# TMDB (Catálogo)
TMDB_API_KEY=sua_tmdb_api_key_aqui

# Mailtrap (Envio de e-mails de recuperação de senha)
MAILTRAP_API_TOKEN=seu_mailtrap_token_aqui
MAILTRAP_INBOX_ID=seu_inbox_id_aqui

# MariaDB (Infraestrutura da Disciplina / Portainer)
DB_HOST=35.226.64.52
DB_PORT=3306
DB_USER=usuario_mariadb
DB_PASSWORD=senha_mariadb
DB_NAME=banco_mariadb

# JWT Secret (Compartilhado entre microsserviços)
JWT_SECRET=chave_secreta_jwt_minimo_64_caracteres_hexadecimais_aqui

# Comunicação interna entre microsserviços
AUTH_SERVICE_URL=http://auth-service:8081
LOG_SERVICE_URL=http://log-service:8082
FRONTEND_URL=https://gabriel-assis-isw055.lapps.studio
ASPNETCORE_URLS=http://+:8080

# Garage S3 / MinIO Object Storage (Fotos de veículos e perfis)
GARAGE_ENDPOINT=http://garage:3900
GARAGE_ACCESS_KEY=GK_sua_access_key
GARAGE_SECRET_KEY=sua_secret_key
GARAGE_BUCKET_NAME=profile-photos
GARAGE_PUBLIC_BASE_URL=/storage

# Stripe Subscriptions (Modo de Teste — Atividade 11)
